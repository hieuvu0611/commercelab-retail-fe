# ============================================================================
# Commerce Lab Retail - Frontend Next.js 15 Environment Configuration
# ============================================================================

# Chế độ Mock: đặt false để gọi trực tiếp sang Backend Microservices (be/)
NEXT_PUBLIC_MOCK_MODE=false

# Cổng Storefront API Gateway (Go :8080)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Cổng Backoffice & CSKH Support BFF (NestJS :8088)
NEXT_PUBLIC_BACKOFFICE_API_BASE_URL=http://localhost:8088

# Cổng Notification Real-time SSE Stream (Go :8089)
NEXT_PUBLIC_NOTIFICATION_API_BASE_URL=http://localhost:8089
