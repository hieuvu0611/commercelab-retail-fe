# ============================================================================
# Commerce Lab Retail - Frontend Next.js 15 Environment Configuration
# ============================================================================

# Mock mode: set to false to call the backend microservices (be/) directly
NEXT_PUBLIC_MOCK_MODE=false

# Storefront API gateway (Go, :8080); base URL includes /api/v1 (decision D-10)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Backoffice and customer support BFF (NestJS, :8088); base URL includes /api/v1
NEXT_PUBLIC_BACKOFFICE_API_BASE_URL=http://localhost:8088/api/v1

# Real-time notification SSE stream (Go, :8089)
NEXT_PUBLIC_NOTIFICATION_API_BASE_URL=http://localhost:8089

# NextAuth (P1-T11). NEXTAUTH_SECRET encrypts the session cookie: use a long random value (openssl rand -base64 32).
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-only-change-me-use-openssl-rand-base64-32

# Mock mode serves a fake backend from inside the app. In a production build it is refused unless this server-only
# flag is also true (for demos and for testing a production build); never set it on a real deployment.
ALLOW_MOCK_IN_PRODUCTION=false
# Mock mode only: access token lifetime in seconds (default 900). Use a small value to watch token refresh.
MOCK_ACCESS_TTL_SECONDS=900
